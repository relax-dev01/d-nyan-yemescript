-- Character helper
local function getCharacterParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end
-- Find all ClickDetectors in Workspace (represents eatable items)
local function getClickDetectors()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            -- Avoid clicking UI buttons or things not in Workspace models
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") and not parent:IsDescendantOf(LocalPlayer) then
                table.insert(list, obj)
            end
        end
    end
    return list
end
-- Find Nearest ClickDetector
local function getNearestClickDetector()
    local hrp = getCharacterParts()
    if not hrp then return nil end
    
    local detectors = getClickDetectors()
    local nearest = nil
    local shortestDistance = Config.MaxDistance
    
    for _, cd in ipairs(detectors) do
        local parent = cd.Parent
        if parent then
            local dist = (hrp.Position - parent.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearest = cd
            end
        end
    end
    
    return nearest
end
-- Find Sell ring / area
local function getSellPart()
    local names = {"Sell", "SellArea", "SellRing", "SellPart", "Sat", "SatAlani", "Sell Zone"}
    for _, name in ipairs(names) do
        local part = workspace:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then
            return part
        end
    end
    return nil
end
-- Capacity check
local function isFull()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local current = stats:FindFirstChild("Food") or stats:FindFirstChild("Weight") or stats:FindFirstChild("Size") or stats:FindFirstChild("Cubes")
        local capacity = stats:FindFirstChild("MaxFood") or stats:FindFirstChild("Capacity") or stats:FindFirstChild("MaxWeight")
        
        if current and capacity then
            return current.Value >= capacity.Value
        end
    end
    return false
end
-- Move Character
local function tweenTo(pos, speed)
    local hrp = getCharacterParts()
    if not hrp then return end
    
    local distance = (hrp.Position - pos).Magnitude
    if distance < 3 then return end -- already there
    
    local duration = distance / speed
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
    tween:Play()
    tween.Completed:Wait()
end
-- Main Farming loop
task.spawn(function()
    while true do
        task.wait(0.05)
        
        if Config.AutoFarm then
            local hrp, hum = getCharacterParts()
            if hrp and hum then
                -- Auto Sell Check
                if Config.AutoSell and isFull() then
                    StatusLabel.Text = "Durum: Satis Alanina Gidiliyor..."
                    local sell = getSellPart()
                    if sell then
                        tweenTo(sell.Position + Vector3.new(0, 2, 0), Config.FarmSpeed)
                        task.wait(0.6)
                    else
                        StatusLabel.Text = "Hata: Satis Alani Bulunamadi!"
                    end
                else
                    -- Auto Eat Check
                    local cd = getNearestClickDetector()
                    if cd and cd.Parent then
                        local block = cd.Parent
                        local dist = (hrp.Position - block.Position).Magnitude
                        
                        -- If too far, move close to the click detector
                        if dist > Config.ActivationRange then
                            StatusLabel.Text = "Durum: Bloga yaklasiliyor..."
                            tweenTo(block.Position + Vector3.new(0, 1.5, 0), Config.FarmSpeed)
                        end
                        
                        -- Fire Click Detector
                        StatusLabel.Text = "Durum: Blok yeniyor..."
                        if fireclickdetector then
                            pcall(function()
                                fireclickdetector(cd, 0) -- Fire click detector event
                            end)
                        end
                        task.wait(0.05)
                    else
                        StatusLabel.Text = "Durum: Yenilebilir blok araniyor..."
                    end
                end
            end
        end
    end
end)
