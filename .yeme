    if Minimized then
        MainFrame:TweenSize(UDim2.new(0, 280, 0, 50), "Out", "Quad", 0.3, true)
        MinimizeBtn.Text = "+"
    else
        MainFrame:TweenSize(UDim2.new(0, 280, 0, 410), "Out", "Quad", 0.3, true)
        MinimizeBtn.Text = "-"
    end
end)
-- Debug Scanner Logic
DebugBtn.MouseButton1Click:Connect(function()
    StatusLabel.Text = "Durum: Taramaya baslandi."
    pcall(function()
        print("----- EAT THE WORLD SCANNER RESULTS -----")
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        if stats then
            for _, child in ipairs(stats:GetChildren()) do
                print("Leaderstat: " .. tostring(child.Name) .. " = " .. tostring(child.Value))
            end
        else
            print("Leaderstats bulunamadi!")
        end
        
        print("Workspace nesneleri:")
        for _, child in ipairs(workspace:GetChildren()) do
            if child.ClassName == "Folder" or child.ClassName == "Model" then
                print("Klasor/Model: " .. tostring(child.Name))
            end
        end
        print("-----------------------------------------")
    end)
end)
-- Game Functions
local function getCharacterParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end
local function isFood(obj)
    local name = obj.Name:lower()
    for _, food in ipairs(Config.FoodNames) do
        if name:find(food:lower()) then return true end
    end
    return false
end
local function getFoods()
    local foods = {}
    for _, folderName in ipairs(Config.FoodFolderNames) do
        local f = workspace:FindFirstChild(folderName)
        if f then
            for _, child in ipairs(f:GetChildren()) do
                if child:IsA("BasePart") or (child:IsA("Model") and child.PrimaryPart) then
                    table.insert(foods, child)
                end
            end
        end
    end
    for _, child in ipairs(workspace:GetChildren()) do
        if isFood(child) then
            if child:IsA("BasePart") or (child:IsA("Model") and child.PrimaryPart) then
                table.insert(foods, child)
            end
        end
    end
    return foods
end
local function getNearestFood()
    local hrp = getCharacterParts()
    if not hrp then return nil end
    local nearest, dist = nil, Config.MaxDistance
    for _, food in ipairs(getFoods()) do
        local pos = food:IsA("BasePart") and food.Position or food.PrimaryPart.Position
        local d = (hrp.Position - pos).Magnitude
        if d < dist then
            dist = d
            nearest = food
        end
    end
    return nearest
end
local function getSellPart()
    for _, name in ipairs({"Sell", "SellArea", "SellRing", "SellPart", "Sat", "SatAlani"}) do
        local part = workspace:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then return part end
    end
    return nil
end
local function isFull()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local current = stats:FindFirstChild("Food") or stats:FindFirstChild("Weight") or stats:FindFirstChild("Size") or stats:FindFirstChild("Cubes")
        local capacity = stats:FindFirstChild("MaxFood") or stats:FindFirstChild("Capacity") or stats:FindFirstChild("MaxWeight")
        if current and capacity then
            return current.Value >= capacity.Value
        end
    end
    return false
end
local function tweenTo(pos, speed)
    local hrp = getCharacterParts()
    if not hrp then return end
    local duration = (hrp.Position - pos).Magnitude / speed
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
    tween:Play()
    tween.Completed:Wait()
end
task.spawn(function()
    while true do
        task.wait(0.1)
        if Config.AutoFarm then
            local hrp, hum = getCharacterParts()
            if hrp and hum then
                if Config.AutoSell and isFull() then
                    StatusLabel.Text = "Durum: Satis yapiliyor..."
                    local sell = getSellPart()
                    if sell then
                        tweenTo(sell.Position, Config.FarmSpeed)
                        task.wait(0.5)
                    end
                else
                    local food = getNearestFood()
                    if food then
                        local part = food:IsA("BasePart") and food or food.PrimaryPart
                        if part then
                            if Config.FarmMethod == "Teleport Food" then
                                pcall(function() part.CFrame = hrp.CFrame end)
                            else
                                StatusLabel.Text = "Durum: Yemek yeniyor..."
                                tweenTo(part.Position, Config.FarmSpeed)
                            end
                        end
                    end
                end
            end
        end
    end
end)
print("Eat the World Pro loaded successfully!")

